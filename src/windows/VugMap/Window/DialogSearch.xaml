<Window x:Class="VugMap.Window.DialogSearch"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search" Icon="../Resources/Icon.gif" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Loaded="OnLoaded">
	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="30"/>
			<RowDefinition Height="30"/>
			<RowDefinition Height="30"/>
			<RowDefinition Height="30"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="85"/>
			<ColumnDefinition Width="15"/>
			<ColumnDefinition Width="195"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
		<Label Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">Search for</Label>
		<Label Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">:</Label>
		<TextBox Name="m_tbSearch" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Width="190"></TextBox>
		<Label Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">Look in</Label>
		<Label Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">:</Label>
		<ComboBox Name="m_cbLookIn" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Width="190">
			<ComboBoxItem Name="m_cbiCurrentId">Current chromosome ID</ComboBoxItem>
			<ComboBoxItem Name="m_cbiAllId" IsSelected="True">All chromosome IDs</ComboBoxItem>
		</ComboBox>
		<CheckBox Name="m_ckbCase" IsChecked="True" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center">Case sensitive</CheckBox>
		<StackPanel Name="m_splButton" Orientation="Horizontal" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
			<Button Name="m_btnOk" HorizontalAlignment="Left" VerticalAlignment="Center" Width="140" Click="OnOkClick" IsDefault="True" Margin="5,0,5,0">OK</Button>
			<Button Name="m_btnCancel" HorizontalAlignment="Left" VerticalAlignment="Center" Width="140" Click="OnCancelClick" IsCancel="True">Cancel</Button>
		</StackPanel>		
		<ProgressBar Name="m_pbSearch" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Width="300" Height="25"></ProgressBar>
	</Grid>
</Window>
