<Window x:Class="VugMap.Window.DialogFeatureAdd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add a Feature" Icon="../Resources/Icon.gif" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Loaded="OnLoaded">
	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="25"/>
			<RowDefinition Height="25"/>
			<RowDefinition Height="25"/>
			<RowDefinition Height="25"/>
			<RowDefinition Height="25"/>
			<RowDefinition Height="25"/>
			<RowDefinition Height="90"/>
			<RowDefinition Height="30"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="85"/>
			<ColumnDefinition Width="15"/>
			<ColumnDefinition Width="195"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
		<Label Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">Source</Label>
		<Label Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">:</Label>
		<TextBox Name="m_tbSource" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Width="190"></TextBox>
		<Label Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">Start</Label>
		<Label Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">:</Label>
		<Grid Grid.Row="1" Grid.Column="2">
			<Grid.RowDefinitions>
				<RowDefinition Height="*"/>				
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="165"/>
				<ColumnDefinition Width="25"/>				
			</Grid.ColumnDefinitions>
			<TextBox Name="m_tbStart" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="165"></TextBox>
			<Button Name="m_btnSize" Grid.Row="0" Grid.Column="1" Width="22" Height="22" Click="OnSizeClick">></Button>
		</Grid>		
		<Label Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">End</Label>
		<Label Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">:</Label>
		<TextBox Name="m_tbEnd" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Width="190"></TextBox>
		<Label Grid.Row="3" Grid.Column="0" VerticalAlignment="Center">Score</Label>
		<Label Grid.Row="3" Grid.Column="1" VerticalAlignment="Center">:</Label>
		<TextBox Name="m_tbScore" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Width="190">0.0</TextBox>
		<Label Grid.Row="4" Grid.Column="0" VerticalAlignment="Center">Strand</Label>
		<Label Grid.Row="4" Grid.Column="1" VerticalAlignment="Center">:</Label>
		<TextBox Name="m_tbStrand" Grid.Row="4" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Width="190">.</TextBox>			
		<Label Grid.Row="5" Grid.Column="0" VerticalAlignment="Center">Phase</Label>
		<Label Grid.Row="5" Grid.Column="1" VerticalAlignment="Center">:</Label>
		<TextBox Name="m_tbPhase" Grid.Row="5" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Width="190">.</TextBox>
		<Label Grid.Row="6" Grid.Column="0" VerticalAlignment="Top">Attribute</Label>
		<Label Grid.Row="6" Grid.Column="1" VerticalAlignment="Top">:</Label>
		<TextBox Name="m_tbAttribute" Grid.Row="6" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="Wrap" Width="190" Height="90"></TextBox>
		<StackPanel Orientation="Horizontal" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3">
			<Button Name="m_btnOk" HorizontalAlignment="Left" VerticalAlignment="Center" Width="140" Click="OnOkClick" Margin="5,0,5,0">OK</Button>
			<Button Name="m_btnCancel" HorizontalAlignment="Left" VerticalAlignment="Center" Width="140" Click="OnCancelClick">Cancel</Button>
		</StackPanel>
	</Grid>
</Window>
