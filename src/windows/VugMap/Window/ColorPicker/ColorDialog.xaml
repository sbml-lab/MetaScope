<Window x:Class="VugMap.Window.ColorPicker.ColorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VugMap.Window.ColorPicker"
    Icon="Images/ColorSwatchSquare.png"
    Title="Pick Color" Width="520" Height="270" 
    KeyDown="Window_KeyDown"
    WindowStartupLocation="CenterOwner"  ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <local:ColorPicker x:Name="colorPicker"/>
        <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal" Margin="5" >
            <Button x:Name="btnOk" Content="Ok" Click="btnOk_Click" IsDefault="True" Width="60" Height="25" Margin="10,0,0,0" />
            <Button x:Name="btnCancel" Content="Cancel" Click="btnCancel_Click" IsCancel="True" Height="25" Width="60" Margin="10,0,10,0" />
        </StackPanel>
    </Grid>
    
        
</Window>
