<Window x:Class="VugMap.Window.DialogSetHeight"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Set Height" Icon="../Resources/Icon.gif" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Loaded="OnLoaded">
	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="30"/>
			<RowDefinition Height="30"/>
			<RowDefinition Height="30"/>
			<RowDefinition Height="30"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="95"/>
			<ColumnDefinition Width="15"/>
			<ColumnDefinition Width="110"/>
			<ColumnDefinition Width="40"/>
		</Grid.ColumnDefinitions>
		<Label Grid.ColumnSpan="4" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">Set height of the lane:</Label>
		<RadioButton Name="m_rbAutomatic" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Checked="OnAutomaticChecked">Automatic</RadioButton>
		<RadioButton Name="m_rbManual" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Checked="OnManualChecked">Manual</RadioButton>
		<Label Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">:</Label>
		<Label Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">:</Label>
		<TextBox Name="m_tbHeight" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Width="100"></TextBox>
		<Label Grid.Row="2" Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center">pixels</Label>
		<StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4">
			<Button Name="m_btnOk" HorizontalAlignment="Left" VerticalAlignment="Center" Width="120" Click="OnOkClick" IsDefault="True" Margin="5,0,10,0">OK</Button>
			<Button Name="m_btnCancel" HorizontalAlignment="Left" VerticalAlignment="Center" Width="120" Click="OnCancelClick" IsCancel="True">Cancel</Button>
		</StackPanel>		
	</Grid>
</Window>
