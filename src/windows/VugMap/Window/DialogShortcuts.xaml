<Window x:Class="VugMap.Window.DialogShortcuts"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Keyboard Shortcuts" Width="520" Height="560"
		WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
		Background="White">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
			<StackPanel x:Name="m_spContent"/>
		</ScrollViewer>

		<Button Grid.Row="1" Content="OK" Width="80" Height="28" Margin="0,12,0,0"
				HorizontalAlignment="Center" Click="OnOkClick" IsDefault="True"/>
	</Grid>
</Window>
