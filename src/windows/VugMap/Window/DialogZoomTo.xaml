<Window x:Class="VugMap.Window.DialogZoomTo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zoom To" Icon="../Resources/Icon.gif" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Loaded="OnLoaded">
	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="25"/>
			<RowDefinition Height="25"/>
			<RowDefinition Height="25"/>
			<RowDefinition Height="25"/>
			<RowDefinition Height="25"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="80"/>
			<ColumnDefinition Width="15"/>
			<ColumnDefinition Width="165"/>
		</Grid.ColumnDefinitions>
		<Label Grid.ColumnSpan="4" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">Zoom to:</Label>
		<RadioButton Name="m_rbMinimum" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Checked="OnMinimumChecked">Minimum</RadioButton>
		<Label Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">:</Label>
		<Label Name="m_lblZoomMin" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"></Label>
		<RadioButton Name="m_rbMaximum" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Checked="OnMaximumChecked">Maximum</RadioButton>
		<Label Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">:</Label>
		<Label Name="m_lblZoomMax" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"></Label>
		<RadioButton Name="m_rbOther" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Checked="OnOtherChecked">Other</RadioButton>
		<Label Grid.Row="3" Grid.Column="1" VerticalAlignment="Center">:</Label>
		<TextBox Name="m_tbZoomTo" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Width="146"></TextBox>
		<StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
			<Button Name="m_btnOk" HorizontalAlignment="Left" VerticalAlignment="Center" Width="120" Click="OnOkClick" IsDefault="True" Margin="5,0,10,0">OK</Button>
			<Button Name="m_btnCancel" HorizontalAlignment="Left" VerticalAlignment="Center" Width="120" Click="OnCancelClick" IsCancel="True">Cancel</Button>
		</StackPanel>
	</Grid>
</Window>
