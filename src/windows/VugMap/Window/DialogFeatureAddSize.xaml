<Window x:Class="VugMap.Window.DialogFeatureAddSize"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Size Feature" Icon="../Resources/Icon.gif" Width="400" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Loaded="OnLoaded" >
	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="25"/>
			<RowDefinition Height="25"/>
			<RowDefinition Height="25"/>
			<RowDefinition Height="25"/>
			<RowDefinition Height="25"/>
			<RowDefinition Height="25"/>
			<RowDefinition Height="25"/>
			<RowDefinition Height="25"/>
			<RowDefinition Height="25"/>
			<RowDefinition Height="25"/>
			<RowDefinition Height="25"/>
			<RowDefinition Height="30"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="25"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
		<Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center">* Fix position at</Label>
		<RadioButton Name="m_rbPosStart" GroupName="Position" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">Start position of the feature</RadioButton>
		<RadioButton Name="m_rbPosMiddle" GroupName="Position" IsChecked="True" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">Center of the feature</RadioButton>
		<Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center">* Set width of the feature</Label>
		<RadioButton Name="m_rbWidth50" GroupName="Width" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">50 bp</RadioButton>
		<RadioButton Name="m_rbWidth100" GroupName="Width" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">100 bp</RadioButton>
		<RadioButton Name="m_rbWidth150" GroupName="Width" Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">150 bp</RadioButton>
		<RadioButton Name="m_rbWidth200" GroupName="Width" Grid.Row="7" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">200 bp</RadioButton>
		<RadioButton Name="m_rbWidth250" IsChecked="True" GroupName="Width" Grid.Row="8" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">250 bp</RadioButton>
		<RadioButton Name="m_rbWidth300" GroupName="Width" Grid.Row="9" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">300 bp</RadioButton>
		<StackPanel Orientation="Horizontal" Grid.Row="10" Grid.Column="1">
			<RadioButton Name="m_rbWidthArbitrary" GroupName="Width" HorizontalAlignment="Left" VerticalAlignment="Center"></RadioButton>
			<TextBox Name="m_tbWidth" Width="50" Margin="4, 0, 0, 0">400</TextBox>
			<Label>bp</Label>
		</StackPanel>
		<StackPanel Name="m_spButton" Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2">
			<Button Name="m_btnOk" HorizontalAlignment="Left" VerticalAlignment="Center" Width="170" Click="OnOkClick" IsDefault="True" Margin="5,0,5,0">OK</Button>
			<Button Name="m_btnCancel" HorizontalAlignment="Left" VerticalAlignment="Center" Width="170" Click="OnCancelClick" IsCancel="True">Cancel</Button>
		</StackPanel>
	</Grid>
</Window>
