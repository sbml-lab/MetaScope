<Window x:Class="MetaScope.MainWindow"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:local="clr-namespace:MetaScope"
	mc:Ignorable="d"
	x:CompileBindings="False"
	d:DesignWidth="1024" d:DesignHeight="768"
	Title="MetaScope v1.2.2"
	Width="1024" Height="768"
	WindowState="Maximized"
	Background="White"
	FontFamily="Helvetica Neue"
	DragDrop.AllowDrop="True">

	<Window.Styles>
		<StyleInclude Source="avares://MetaScope/Styles/MainWindow.axaml"/>
	</Window.Styles>

	<DockPanel x:Name="m_dpMain" LastChildFill="True">
		<LayoutTransformControl>
			<LayoutTransformControl.LayoutTransform>
				<ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
			</LayoutTransformControl.LayoutTransform>

			<DockPanel x:Name="m_dpInner" LastChildFill="True">
				<NativeMenuBar DockPanel.Dock="Top"/>

				<!-- STATUS BAR -->
				<Border DockPanel.Dock="Bottom" BorderThickness="0,0.5,0,0" BorderBrush="#D5D5D5"
					Padding="10,6" Background="#F0F0F0">
					<StackPanel Orientation="Horizontal" Spacing="4">
						<TextBlock x:Name="m_tbStatusPosition" Classes="statusbar" Text="Ready" Width="200"/>
						<TextBlock Classes="statusbar" Text="|" Foreground="#C7C7CC"/>
						<TextBlock x:Name="m_tbStatusZoom" Classes="statusbar" Text="" Width="100"/>
						<TextBlock Classes="statusbar" Text="|" Foreground="#C7C7CC"/>
						<TextBlock x:Name="m_tbStatusFeatureCount" Classes="statusbar" Text="" Width="150"/>
						<TextBlock Classes="statusbar" Text="|" Foreground="#C7C7CC"/>
						<TextBlock x:Name="m_tbStatusFileName" Classes="statusbar" Text="" Width="300"/>
					</StackPanel>
				</Border>

				<!-- MAIN CONTENT -->
				<Grid x:Name="m_grdContent">
					<Grid.RowDefinitions>
						<RowDefinition Height="*"/>
						<RowDefinition Height="0"/>
						<RowDefinition Height="0"/>
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="3*"/>
						<ColumnDefinition Width="4"/>
						<ColumnDefinition Width="340" MinWidth="310"/>
					</Grid.ColumnDefinitions>

					<!-- DOCUMENT PANE -->
					<TabControl x:Name="m_tabDocuments" Classes="safari-tabs"
						Grid.Row="0" Grid.Column="0"
						TabStripPlacement="Top"
						Theme="{x:Null}"
						HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
						HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
						<TabControl.Template>
							<ControlTemplate TargetType="TabControl">
								<DockPanel>
									<Border DockPanel.Dock="Top" Background="#DFDFE4"
										Padding="2,3,2,1" Margin="6" CornerRadius="100">
										<!-- measured: the tab row lands ~1pt high with symmetric padding (BoxShadow/Margin -1 on the pill), so bias the padding -->
										<ItemsPresenter Name="PART_ItemsPresenter" Margin="0" VerticalAlignment="Center">
											<ItemsPresenter.ItemsPanel>
												<ItemsPanelTemplate>
													<StackPanel Orientation="Horizontal" Spacing="0" Margin="0" VerticalAlignment="Center"/>
												</ItemsPanelTemplate>
											</ItemsPresenter.ItemsPanel>
										</ItemsPresenter>
									</Border>
									<ContentPresenter Name="PART_SelectedContentHost"
										Content="{TemplateBinding SelectedContent}"
										ContentTemplate="{TemplateBinding SelectedContentTemplate}"
										HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
										VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
								</DockPanel>
							</ControlTemplate>
						</TabControl.Template>
					</TabControl>

					<!-- VERTICAL SPLITTER -->
					<GridSplitter Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
						ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Width="4"/>

					<!-- RIGHT TOOL PANE -->
					<Border x:Name="m_bdrTools" Grid.Row="0" Grid.RowSpan="3" Grid.Column="2"
						Background="#F2F2F7" BorderThickness="0.5,0,0,0" BorderBrush="#D5D5D5">
						<DockPanel>
							<Border DockPanel.Dock="Top" Padding="12,8" Background="#E5E5EA"
								BorderThickness="0,0,0,0.5" BorderBrush="#D5D5D5">
								<Grid>
									<TextBlock Text="Inspector" FontSize="13" FontWeight="SemiBold"
										Foreground="#1D1D1F" VerticalAlignment="Center"/>
									<Button x:Name="m_btnFloatTools" Classes="float-btn"
										Content="▤" HorizontalAlignment="Right"
										ToolTip.Tip="Float panel" Click="OnFloatToolsClick"/>
								</Grid>
							</Border>
							<TabControl x:Name="m_tabTools" TabStripPlacement="Top"
								HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
								HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
								<TabItem Header="Explorer" ToolTip.Tip="Workspace Explorer" x:Name="m_tabExplorer">
									<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
										<TreeView x:Name="m_trvFile" DragDrop.AllowDrop="True" Background="Transparent" Margin="-8,0,0,0">
											<TreeViewItem Header="File" x:Name="m_tviFile" IsExpanded="True"/>
											<TreeViewItem Header="Chromosome ID" x:Name="m_tviSequenceId" IsExpanded="True"/>
											<TreeViewItem Header="Type" x:Name="m_tviType" IsExpanded="True"/>
										</TreeView>
									</ScrollViewer>
								</TabItem>
								<TabItem Header="Edit" x:Name="m_tabEdit">
									<ListBox x:Name="m_ltvEdit" Background="Transparent"/>
								</TabItem>
								<TabItem Header="Bookmark" x:Name="m_tabBookmark">
									<ListBox x:Name="m_ltvBookmark" Background="Transparent"/>
								</TabItem>
								<TabItem Header="Selected" ToolTip.Tip="Feature Selected" x:Name="m_tabFeatureSelected">
									<ListBox x:Name="m_ltvFeatureSelected" Background="Transparent"/>
								</TabItem>
								<TabItem Header="Feature" x:Name="m_tabFeature">
									<ListBox x:Name="m_ltvFeature" Background="Transparent"/>
								</TabItem>
							</TabControl>
						</DockPanel>
					</Border>

					<!-- HORIZONTAL SPLITTER -->
					<GridSplitter Grid.Row="1" Grid.Column="0"
						ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
						Height="4" HorizontalAlignment="Stretch"/>

					<!-- BOTTOM PANE -->
					<Border Grid.Row="2" Grid.Column="0" BorderThickness="0,0.5,0,0" BorderBrush="#D5D5D5">
					  <Grid>
						<TabControl x:Name="m_tabBottom" TabStripPlacement="Top">
							<TabItem Header="Search" x:Name="m_tabSearch">
								<ListBox x:Name="m_ltvSearch" Background="Transparent"/>
							</TabItem>
							<TabItem Header="Log" x:Name="m_tabLog" IsVisible="False">
								<TextBox x:Name="m_tbLogLog" FontFamily="Menlo, 'SF Mono', Consolas, monospace"
									FontSize="11" IsReadOnly="True" AcceptsReturn="True"
									TextWrapping="Wrap" Margin="8" Background="Transparent"/>
							</TabItem>
						</TabControl>
						<Button Classes="float-btn" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
							Margin="0,4,8,0" ToolTip.Tip="Close" Click="OnBottomPaneCloseClick"/>
					  </Grid>
					</Border>
				</Grid>
			</DockPanel>
		</LayoutTransformControl>
	</DockPanel>
</Window>
