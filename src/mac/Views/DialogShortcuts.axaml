<Window x:Class="MetaScope.Views.DialogShortcuts"
		xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d"
		Title="Keyboard Shortcuts" Width="520" Height="560"
		WindowStartupLocation="CenterOwner" CanResize="False"
		>
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
			<StackPanel x:Name="m_spContent"/>
		</ScrollViewer>

		<Button Grid.Row="1" Classes="accent" Content="OK" Width="80" Height="28" Margin="0,12,0,0"
				HorizontalAlignment="Center" Click="OnOkClick" IsDefault="True" IsCancel="True"/>
	</Grid>
</Window>
