<Window Classes="dialog" x:Class="MetaScope.Views.DialogBookmarkAdd"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	Title="Add Bookmark" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" CanResize="False" Loaded="OnLoaded">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" MinHeight="28"/>
			<RowDefinition Height="Auto" MinHeight="28"/>
			<RowDefinition Height="Auto" MinHeight="28"/>
			<RowDefinition Height="Auto" MinHeight="28"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" MinWidth="95"/>
			<ColumnDefinition Width="Auto" MinWidth="15"/>
			<ColumnDefinition Width="Auto" MinWidth="195"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
		<Label Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">Title</Label>
		<Label Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">:</Label>
		<TextBox Name="m_tbTitle" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center"></TextBox>
		<Label Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">Position</Label>
		<Label Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">:</Label>
		<TextBox Name="m_tbPosition" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center"></TextBox>
		<Label Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">Zoom</Label>
		<Label Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">:</Label>
		<TextBox Name="m_tbZoom" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center"></TextBox>
		<StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,12,0,0" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
			<Button Name="m_btnCancel" Width="90" Click="OnCancelClick" IsCancel="True">Cancel</Button>
			<Button Name="m_btnOk" Classes="accent" Width="90" Margin="8,0,0,0" Click="OnOkClick" IsDefault="True">OK</Button>
		</StackPanel>
	</Grid>
</Window>
