<Window Classes="dialog" x:Class="MetaScope.Views.DialogSetHeight"
		xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d"
		Title="Set Height" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" CanResize="False" Loaded="OnLoaded">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" MinHeight="28"/>
			<RowDefinition Height="Auto" MinHeight="28"/>
			<RowDefinition Height="Auto" MinHeight="28"/>
			<RowDefinition Height="Auto" MinHeight="28"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" MinWidth="95"/>
			<ColumnDefinition Width="Auto" MinWidth="15"/>
			<ColumnDefinition Width="Auto" MinWidth="110"/>
			<ColumnDefinition Width="Auto" MinWidth="40"/>
		</Grid.ColumnDefinitions>
		<Label Grid.ColumnSpan="4" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">Set height of the lane:</Label>
		<RadioButton Name="m_rbAutomatic" GroupName="Height" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" IsCheckedChanged="OnAutomaticChecked">Automatic</RadioButton>
		<RadioButton Name="m_rbManual" GroupName="Height" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" IsCheckedChanged="OnManualChecked">Manual</RadioButton>
		<Label Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">:</Label>
		<Label Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">:</Label>
		<TextBox Name="m_tbHeight" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Width="100"></TextBox>
		<Label Grid.Row="2" Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center">pixels</Label>
		<StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,12,0,0" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4">
			<Button Name="m_btnCancel" Width="90" Click="OnCancelClick" IsCancel="True">Cancel</Button>
			<Button Name="m_btnOk" Classes="accent" Width="90" Margin="8,0,0,0" Click="OnOkClick" IsDefault="True">OK</Button>
		</StackPanel>
	</Grid>
</Window>
