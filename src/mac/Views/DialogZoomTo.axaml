<Window Classes="dialog" x:Class="MetaScope.Views.DialogZoomTo"
		xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d"
		Title="Zoom To" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" CanResize="False" Loaded="OnLoaded">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" MinHeight="28"/>
			<RowDefinition Height="Auto" MinHeight="28"/>
			<RowDefinition Height="Auto" MinHeight="28"/>
			<RowDefinition Height="Auto" MinHeight="28"/>
			<RowDefinition Height="Auto" MinHeight="28"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" MinWidth="80"/>
			<ColumnDefinition Width="Auto" MinWidth="15"/>
			<ColumnDefinition Width="Auto" MinWidth="165"/>
		</Grid.ColumnDefinitions>
		<Label Grid.ColumnSpan="4" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">Zoom to:</Label>
		<RadioButton Name="m_rbMinimum" GroupName="Zoom" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" IsCheckedChanged="OnMinimumChecked">Minimum</RadioButton>
		<Label Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">:</Label>
		<Label Name="m_lblZoomMin" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"></Label>
		<RadioButton Name="m_rbMaximum" GroupName="Zoom" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" IsCheckedChanged="OnMaximumChecked">Maximum</RadioButton>
		<Label Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">:</Label>
		<Label Name="m_lblZoomMax" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"></Label>
		<RadioButton Name="m_rbOther" GroupName="Zoom" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" IsCheckedChanged="OnOtherChecked">Other</RadioButton>
		<Label Grid.Row="3" Grid.Column="1" VerticalAlignment="Center">:</Label>
		<TextBox Name="m_tbZoomTo" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Width="146"></TextBox>
		<StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,12,0,0" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
			<Button Name="m_btnCancel" Width="90" Click="OnCancelClick" IsCancel="True">Cancel</Button>
			<Button Name="m_btnOk" Classes="accent" Width="90" Margin="8,0,0,0" Click="OnOkClick" IsDefault="True">OK</Button>
		</StackPanel>
	</Grid>
</Window>
