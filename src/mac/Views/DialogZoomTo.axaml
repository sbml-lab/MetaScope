<Window x:Class="MetaScope.Views.DialogZoomTo"
		xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d"
		Title="Zoom To" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" CanResize="False" Loaded="OnLoaded">
	<Window.Styles>
		<Style Selector="TextBox">
			<Setter Property="Padding" Value="6,4"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="Height" Value="28"/>
		</Style>
		<Style Selector="Label">
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Padding" Value="0"/>
		</Style>
		<Style Selector="ComboBox">
			<Setter Property="Padding" Value="6,4"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="Height" Value="28"/>
		</Style>
		<Style Selector="RadioButton">
			<Setter Property="Padding" Value="6,3"/>
			<Setter Property="MinHeight" Value="0"/>
		</Style>
		<Style Selector="CheckBox">
			<Setter Property="Padding" Value="6,3"/>
			<Setter Property="MinHeight" Value="0"/>
		</Style>
		<Style Selector="Button">
			<Setter Property="Padding" Value="8,4"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="Height" Value="28"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>
		<Style Selector="RadioButton /template/ Ellipse">
			<Setter Property="Width" Value="16"/>
			<Setter Property="Height" Value="16"/>
		</Style>
		<Style Selector="CheckBox /template/ Border#NormalRectangle">
			<Setter Property="Width" Value="16"/>
			<Setter Property="Height" Value="16"/>
		</Style>
	</Window.Styles>
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" MinHeight="28"/>
			<RowDefinition Height="Auto" MinHeight="28"/>
			<RowDefinition Height="Auto" MinHeight="28"/>
			<RowDefinition Height="Auto" MinHeight="28"/>
			<RowDefinition Height="Auto" MinHeight="28"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="80"/>
			<ColumnDefinition Width="15"/>
			<ColumnDefinition Width="165"/>
		</Grid.ColumnDefinitions>
		<Label Grid.ColumnSpan="4" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">Zoom to:</Label>
		<RadioButton Name="m_rbMinimum" GroupName="Zoom" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" IsCheckedChanged="OnMinimumChecked">Minimum</RadioButton>
		<Label Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">:</Label>
		<Label Name="m_lblZoomMin" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"></Label>
		<RadioButton Name="m_rbMaximum" GroupName="Zoom" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" IsCheckedChanged="OnMaximumChecked">Maximum</RadioButton>
		<Label Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">:</Label>
		<Label Name="m_lblZoomMax" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"></Label>
		<RadioButton Name="m_rbOther" GroupName="Zoom" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" IsCheckedChanged="OnOtherChecked">Other</RadioButton>
		<Label Grid.Row="3" Grid.Column="1" VerticalAlignment="Center">:</Label>
		<TextBox Name="m_tbZoomTo" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Width="146"></TextBox>
		<StackPanel Orientation="Horizontal" Margin="0,2,0,0" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
			<Button Name="m_btnCancel" HorizontalAlignment="Left" VerticalAlignment="Center" Width="120" Click="OnCancelClick" IsCancel="True">Cancel</Button>
			<Button Name="m_btnOk" Classes="accent" HorizontalAlignment="Left" VerticalAlignment="Center" Width="120" Click="OnOkClick" IsDefault="True" Margin="5,0,10,0">OK</Button>
		</StackPanel>
	</Grid>
</Window>
