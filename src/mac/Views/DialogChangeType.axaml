<Window Classes="dialog" x:Class="MetaScope.Views.DialogChangeType"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Type" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" CanResize="False">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" MinHeight="28"/>
			<RowDefinition Height="Auto" MinHeight="28"/>
			<RowDefinition Height="Auto" MinHeight="28"/>
			<RowDefinition Height="Auto" MinHeight="28"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" MinWidth="95"/>
			<ColumnDefinition Width="Auto" MinWidth="15"/>
			<ColumnDefinition Width="Auto" MinWidth="330"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
		<Label Grid.ColumnSpan="4" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">Change type of the track:</Label>
		<Label Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">Current type</Label>
		<Label Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">New type</Label>
		<Label Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">:</Label>
		<Label Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">:</Label>
		<TextBox Name="m_tbCurrent" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Width="330" IsEnabled="False"></TextBox>
		<TextBox Name="m_tbToSet" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Width="330"></TextBox>
		<StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,12,0,0" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
			<Button Name="m_btnCancel" Width="90" Click="OnCancelClick" IsCancel="True">Cancel</Button>
			<Button Name="m_btnOk" Classes="accent" Width="90" Margin="8,0,0,0" Click="OnOkClick" IsDefault="True">OK</Button>
		</StackPanel>
	</Grid>
</Window>
