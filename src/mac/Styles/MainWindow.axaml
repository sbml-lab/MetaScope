<!-- MainWindow styles. Shared with the floating Inspector window (OnFloatToolsClick), which must re-include them: Window.Styles do not follow content moved to another Window. -->
<Styles xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!-- ═══ Tab content stretch ═══ -->
	<Style Selector="TabControl > ContentPresenter">
		<Setter Property="HorizontalAlignment" Value="Stretch"/>
		<Setter Property="VerticalAlignment" Value="Stretch"/>
	</Style>

	<!-- ═══ Document tabs: Safari style ═══ -->
	<Style Selector="TabControl#m_tabDocuments">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Padding" Value="0"/>
	</Style>
	<Style Selector="TabControl#m_tabDocuments TabItem">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="#5C5C66"/>
		<Setter Property="FontSize" Value="11"/>
		<Setter Property="FontWeight" Value="Normal"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="MinHeight" Value="0"/>
		<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
		<Setter Property="VerticalContentAlignment" Value="Stretch"/>
		<Setter Property="Template">
			<ControlTemplate TargetType="TabItem">
				<Border x:Name="PART_Root"
						Background="Transparent"
						CornerRadius="100"
						Padding="27,0,25,0"
						Margin="1,0">
					<ContentPresenter x:Name="PART_HeaderPresenter"
									  Content="{TemplateBinding Header}"
									  HorizontalAlignment="Center"
									  VerticalAlignment="Center"
									  FontSize="11"/>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>
	<Style Selector="TabControl#m_tabDocuments TabItem:selected /template/ Border#PART_Root">
		<Setter Property="Background" Value="White"/>
		<Setter Property="BorderBrush" Value="#00000018"/>
		<Setter Property="BorderThickness" Value="0.5"/>
	</Style>
	<Style Selector="TabControl#m_tabDocuments TabItem:pointerover /template/ Border#PART_Root">
		<Setter Property="Background" Value="#D5D5DA"/>
	</Style>
	<Style Selector="TabControl#m_tabDocuments TabItem:selected:pointerover /template/ Border#PART_Root">
		<Setter Property="Background" Value="White"/>
	</Style>
	<Style Selector="TabControl#m_tabDocuments TabItem:selected">
		<Setter Property="Foreground" Value="#1D1D1F"/>
	</Style>
	<!-- Close button: Safari style -->
	<Style Selector="TabControl#m_tabDocuments TabItem Button.tab-close">
		<Setter Property="Opacity" Value="0"/>
		<Setter Property="Background" Value="#18000000"/>
		<Setter Property="Foreground" Value="#666666"/>
	</Style>
	<Style Selector="TabControl#m_tabDocuments TabItem:pointerover Button.tab-close">
		<Setter Property="Opacity" Value="1"/>
	</Style>
	<Style Selector="TabControl#m_tabDocuments TabItem Button.tab-close:pointerover">
		<Setter Property="Background" Value="#50000000"/>
		<Setter Property="Foreground" Value="#333333"/>
	</Style>

	<!-- ═══ Status bar ═══ -->
	<Style Selector="TextBlock.statusbar">
		<Setter Property="FontFamily" Value="Menlo, 'SF Mono', Consolas, monospace"/>
		<Setter Property="FontSize" Value="11"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Foreground" Value="#636366"/>
	</Style>

	<!-- ═══ Splitters ═══ -->
	<Style Selector="GridSplitter">
		<Setter Property="Background" Value="#E5E5EA"/>
	</Style>
	<Style Selector="GridSplitter:pointerover">
		<Setter Property="Background" Value="#C7C7CC"/>
	</Style>

	<!-- ═══ Tree view ═══ -->
	<Style Selector="TreeView">
		<Setter Property="HorizontalAlignment" Value="Stretch"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="Margin" Value="0"/>
	</Style>
	<Style Selector="TreeViewItem">
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="HorizontalAlignment" Value="Left"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="Margin" Value="0,-1,0,0"/>
	</Style>
	<!-- Reduce FluentTheme internal indentation -->
	<Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
		<Setter Property="Padding" Value="0"/>
		<Setter Property="Margin" Value="0"/>
	</Style>
	<!-- Always reserve space for chevron, but hide it when no children -->
	<Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
		<Setter Property="IsVisible" Value="True"/>
	</Style>
	<Style Selector="TreeViewItem:empty /template/ ToggleButton#PART_ExpandCollapseChevron">
		<Setter Property="Opacity" Value="0"/>
		<Setter Property="IsHitTestVisible" Value="False"/>
	</Style>

	<!-- ═══ Float button ═══ -->
	<Style Selector="Button.float-btn">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Padding" Value="6,2"/>
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="Foreground" Value="#86868B"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>
	<Style Selector="Button.float-btn:pointerover">
		<Setter Property="Foreground" Value="#1D1D1F"/>
	</Style>
	<!-- ═══ Tool / bottom pane tabs: compact so the strip stays on one row ═══ -->
	<Style Selector="TabControl#m_tabTools TabItem, TabControl#m_tabBottom TabItem">
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="Padding" Value="8,6,8,0"/>
		<Setter Property="MinHeight" Value="0"/>
	</Style>
	<Style Selector="TabControl#m_tabTools TabItem /template/ ContentPresenter#PART_ContentPresenter, TabControl#m_tabBottom TabItem /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Margin" Value="0,0,0,7"/>
	</Style>
	<!-- never wrap the strip: default ItemsPanel is a WrapPanel -->
	<Style Selector="TabControl#m_tabTools, TabControl#m_tabBottom">
		<Setter Property="ItemsPanel">
			<ItemsPanelTemplate>
				<StackPanel Orientation="Horizontal"/>
			</ItemsPanelTemplate>
		</Setter>
	</Style>
</Styles>
