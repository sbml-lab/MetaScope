		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:ad="clr-namespace:AvalonDock;assembly=AvalonDock"
		xmlns:vm="clr-namespace:VugMap"		
		Title="" Icon="Resources/Icon.gif" Width="1024" Height="768" WindowState="Maximized" Loaded="OnLoaded" AllowDrop="True" Drop="OnDrop" Closing="OnClosing">
	<Window.Resources>
		<Style x:Key="STYLE_SEARCH" TargetType="{x:Type ListViewItem}">
			<EventSetter Event="MouseDoubleClick" Handler="OnSearchItemDoubleClick"/>
		</Style>
		<Style x:Key="STYLE_BOOKMARK" TargetType="{x:Type ListViewItem}">
			<EventSetter Event="MouseDoubleClick" Handler="OnBookmarkItemDoubleClick"/>
		</Style>
	</Window.Resources>
